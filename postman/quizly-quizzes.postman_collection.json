          "raw": "{\"title\": \"Postman updated title\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
