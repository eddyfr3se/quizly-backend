{
  "info": {
    "name": "Quizly - Quiz management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against python -m quiz_app.tests.server with its temporary environment file. It supplies runtime-only accounts and quiz IDs. The deletion fixture is disposable."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001/api/"
    }
  ],
  "item": [
    {
      "name": "Login owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}login/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.variables.set('owner_access', pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('access_token=')).value.split(';')[0].slice('access_token='.length));"
            ]
          }
        }
      ]
    },
    {
      "name": "List contains only own quizzes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{owner_access}}"
          }
        ],
        "url": "{{base_url}}quizzes/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Owned array', () => {const data=pm.response.json();pm.expect(data).to.be.an('array');pm.expect(data.map(q=>q.id).sort()).to.eql([Number(pm.variables.get('quiz_id')),Number(pm.variables.get('delete_quiz_id'))].sort());});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read own quiz",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{owner_access}}"
          }
        ],
        "url": "{{base_url}}quizzes/{{quiz_id}}/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const quiz = pm.response.json();",
              "pm.test('Exact quiz fields', () => pm.expect(Object.keys(quiz).sort()).to.eql(['created_at','description','id','questions','title','updated_at','video_url']));",
              "pm.test('Ten nested fixture questions', () => {pm.expect(quiz.questions).to.have.lengthOf(10); for (const question of quiz.questions) {pm.expect(Object.keys(question).sort()).to.eql(['answer','id','question_options','question_title']); pm.expect(question.question_options).to.have.lengthOf(4); pm.expect(question.question_options).to.include(question.answer);}});"
            ]
          }
        }
      ]
    },
    {
      "name": "Patch title only",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{owner_access}}"
