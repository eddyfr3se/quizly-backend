    {
      "name": "Login successfully with frontend origin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "http://127.0.0.1:5500"
          }
        ],
        "url": "{{base_url}}login/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Exact login fields', () => {pm.expect(Object.keys(data).sort()).to.eql(['detail','user']); pm.expect(data.detail).to.eql('Login successfully!'); pm.expect(Object.keys(data.user).sort()).to.eql(['email','id','username']); pm.expect(data.user.username).to.eql(pm.variables.get('username')); pm.expect(data.user.email).to.eql(pm.variables.get('email')); pm.expect(data.user.id).to.be.a('number');});",
              "pm.test('Response is not cacheable', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
              "pm.test('Exactly two auth cookies', () => pm.expect(cookies).to.have.lengthOf(2));",
              "for (const [name, type, lifetime] of [['access_token','access',300], ['refresh_token','refresh',86400]]) {",
              "  const cookie = cookies.find(value => value.startsWith(name + '='));",
              "  pm.test(name + ' cookie policy', () => {pm.expect(cookie).to.include('HttpOnly'); pm.expect(cookie).to.include('SameSite=Lax'); pm.expect(cookie).to.include('Path=/'); pm.expect(cookie).to.include('Max-Age=' + lifetime); pm.expect(cookie).not.to.include('Secure');});",
              "  const token = cookie.split(';')[0].slice(name.length + 1);",
              "  const payload = JSON.parse(require('buffer').Buffer.from(token.split('.')[1], 'base64').toString());",
              "  pm.test(name + ' claims', () => {pm.expect(payload.token_type).to.eql(type); pm.expect(String(payload.user_id)).to.eql(String(data.user.id)); pm.expect(payload.exp - payload.iat).to.eql(lifetime);});",
              "}"
            ]
          }
        }
      ]
    }
