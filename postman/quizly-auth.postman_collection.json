{
  "info": {
    "name": "Quizly Day 3 - Registration and login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only against a disposable local database. Each run creates one randomly named account. Credentials exist only as runtime variables; the collection stores no account password or token."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('suffix')) {",
          "  const suffix = pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, '');",
          "  pm.variables.set('suffix', suffix);",
          "  pm.variables.set('username', 'pm_' + suffix);",
          "  pm.variables.set('email', 'pm_' + suffix + '@example.com');",
          "  pm.variables.set('upper_email', ('pm_' + suffix + '@example.com').toUpperCase());",
          "  pm.variables.set('password', pm.variables.replaceIn('{{$randomUUID}}') + pm.variables.replaceIn('{{$randomUUID}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Register a new account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}register/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"email\": \"{{email}}\", \"password\": \"{{password}}\", \"confirmed_password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Exact registration response', () => pm.expect(pm.response.json()).to.eql({detail: 'User created successfully!'}));",
              "pm.test('Registration does not log in', () => pm.expect(pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie')).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Reject duplicate username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}register/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"email\": \"other_{{suffix}}@example.com\", \"password\": \"{{password}}\", \"confirmed_password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('No tokens issued', () => pm.expect(pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie')).to.have.lengthOf(0));",
              "pm.test('Username error', () => pm.expect(pm.response.json()).to.have.property('username'));"
            ]
          }
        }
      ]
    },
