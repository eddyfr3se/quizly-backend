        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exact refresh response', () => pm.expect(pm.response.json()).to.eql({detail:'Token refreshed'}));",
              "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
              "pm.test('Only access is renewed', () => {pm.expect(cookies).to.have.lengthOf(1); pm.expect(cookies[0].value).to.include('access_token='); pm.expect(cookies[0].value).to.include('HttpOnly'); pm.expect(cookies[0].value).to.include('Max-Age=300'); pm.expect(cookies[0].value).to.include('SameSite=Lax');});",
              "pm.variables.set('renewed_access', cookies[0].value.split(';')[0].slice('access_token='.length));",
              "pm.test('New access token', () => pm.expect(pm.variables.get('renewed_access')).not.to.eql(pm.variables.get('access_token')));"
            ]
          }
        }
      ]
    },
