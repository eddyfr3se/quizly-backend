{
  "info": {
    "name": "Quizly Day 4 - Session lifecycle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the disposable server: python -m auth_app.tests.server. The test-session route is test-only and is not part of the application API. All credentials and tokens are runtime variables."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001/api/"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('suffix')) {",
          "  const suffix = pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, '');",
          "  pm.variables.set('suffix', suffix);",
          "  pm.variables.set('username', 'pm_' + suffix);",
          "  pm.variables.set('email', 'pm_' + suffix + '@example.com');",
          "  pm.variables.set('upper_email', ('pm_' + suffix + '@example.com').toUpperCase());",
          "  pm.variables.set('password', pm.variables.replaceIn('{{$randomUUID}}') + pm.variables.replaceIn('{{$randomUUID}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Register isolated account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}register/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\", \"email\": \"{{email}}\", \"confirmed_password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login and remember tokens at runtime",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}login/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.variables.set('access_token', pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('access_token=' )).value.split(';')[0].slice('access_token='.length));",
              "pm.variables.set('refresh_token', pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('refresh_token=' )).value.split(';')[0].slice('refresh_token='.length));",
              "pm.variables.set('user_id', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Protected request with access cookie",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "access_token={{access_token}}"
          }
        ],
        "url": "{{base_url}}test-session/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.cookies.jar().clear(pm.variables.get('base_url'), (error) => {if (error) throw error;});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Authenticated account', () => pm.expect(pm.response.json().user_id).to.eql(pm.variables.get('user_id')));"
            ]
          }
        }
      ]
    },
